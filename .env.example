# ============================================================
# FindLink (findlink.site) configuration
# Copy to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Required -------------------------------------------------
# A long random string used to sign sessions & hash IPs.
# Generate one:  openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of your site (used in emails & short links).
APP_URL=https://findlink.site

# --- Automatic HTTPS (Caddy) ----------------------------------
# The docker-compose stack starts a Caddy reverse proxy for you.
# With your domain set here it obtains a free Let's Encrypt
# certificate automatically (ports 80 + 443 must be reachable).
# Leave empty to serve plain HTTP on port 80 (before DNS is ready).
CADDY_DOMAIN=findlink.site

# Optional: email for Let's Encrypt expiry notices
# ACME_EMAIL=you@example.com

# --- Email (Resend) — optional --------------------------------
# Create a free account at https://resend.com (100 emails/day free),
# verify the findlink.site domain there, then paste the API key below.
# Without this, verification links are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM=FindLink <noreply@findlink.site>

# Restrict new registrations to these email domains (comma-separated).
# Default: Gmail + iCloud (gmail.com, googlemail.com, icloud.com,
# me.com, mac.com). Set to * to allow any email address.
# ALLOWED_EMAIL_DOMAINS=gmail.com,googlemail.com,icloud.com,me.com,mac.com

# --- Optional --------------------------------------------------
# Prebuilt app image (recommended on a 512 MB VPS so the VPS never has to
# run `next build`). Built automatically by GitHub Actions on every push
# (.github/workflows/build.yml). install.sh auto-detects it, or set it here:
# IMAGE=ghcr.io/YOUR_USERNAME/findlink:latest
# Empty → the image is built locally from the Dockerfile instead.
# Once set it sticks: `./install.sh --update` keeps pulling this image;
# `./install.sh --build` clears it and returns to local builds.
# Run `./install.sh --help` for all installer options.

# Host port for local (localhost-only) debug access — public traffic
# goes through Caddy on 80/443 (default 3000)
APP_PORT=3000

# Set to 0.0.0.0 to expose the app directly, bypassing Caddy
# (not recommended — you lose automatic HTTPS)
# APP_BIND=127.0.0.1

# Comma-separated list of allowed origins (defaults to APP_URL)
# CORS_ORIGINS=https://findlink.site

# Google Analytics 4 measurement ID (gtag.js) — baked in at image BUILD time
# by GitHub Actions, not read at runtime. Unset → G-R6LJCEJD24 (this site's
# tag). Set a different value only if you fork the project.
# NEXT_PUBLIC_GA_ID=G-R6LJCEJD24

# Google Search Console verification token (HTML-tag method "content" value).
# Optional — emits <meta name="google-site-verification"> when set. Like the GA
# ID it is baked in at image BUILD time by GitHub Actions, not read at runtime.
# Find it: search.google.com/search-console → Add property → HTML tag.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Click analytics GeoIP (country accuracy) -----------------
# Country detection for short-link click stats. Default (unset/empty):
# visitor IPs are resolved through free keyless GeoIP services
# (geojs.io -> ipwho.is -> ip-api.com) with a 30-day cache and a
# 40 lookups/min cap. Behind Cloudflare, the exact CF-IPCountry
# header is used instead (no external call). Set to `off` to record
# no country at all (clicks still count; the country column will
# show "Unknown").
# GEOIP=off

# --- Premium checkout (PayPal Orders API v2) --------------------
# Sells FindLink Premium ($3 / 30 days) on the /premium page.
# 1. Sign in at https://developer.paypal.com (Apps & Credentials)
# 2. Create a REST API app → copy the Client ID + Secret
# 3. Fill them in below and: docker compose up -d  (no image rebuild!)
# Leave empty → the premium page shows "payments coming soon".
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# live = real money. sandbox = PayPal test accounts (default).
PAYPAL_MODE=sandbox

# Who gets emailed when a premium payment lands (comma-separated).
# Empty = every admin account on the site.
# ADMIN_EMAIL=you@example.com

# Premium pricing (defaults shown)
PREMIUM_PRICE_USD=3.00
PREMIUM_DAYS=30
